# Copy this file to .env and fill in real values. .env itself is gitignored.
# In dev (docker-compose.yml), DATABASE_URL/REDIS_URL are already set for
# you and don't need to be repeated here — this file mainly documents what
# a real deploy needs (see the "Production" section in CLAUDE.md).

# Twilio (SMS + WhatsApp notifications) — leave blank in development/test;
# the app uses an in-memory TestAdapter unless these are set and
# RAILS_ENV=production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# --- Events ingestion (camera / device webhooks) ---
# Shared-secret Bearer token every device POST to /api/events must present via
# `Authorization: Bearer <token>`. Required in production; without it every
# request to /api/events is rejected with 401.
EVENTS_INGEST_TOKEN=

# --- Production only (not needed in dev/test) ---

# Decrypts config/credentials.yml.enc — required to boot in production.
# RAILS_MASTER_KEY=

# config/database.yml's production section merges DATABASE_URL on top of
# its username/password fields if both are present; simplest to just rely
# on DATABASE_URL alone.
# DATABASE_URL=postgres://app:password@db-host:5432/app_production
# APP_DATABASE_PASSWORD=

# Action Cable (config/cable.yml) and Sidekiq both read this in production.
# REDIS_URL=redis://redis-host:6379/0

# db/seeds.rb falls back to admin@example.com / changeme123 if unset —
# always set real values before seeding a real production database.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
