<h1>Painel de expedição</h1>

<h2>Pátio</h2>

<table>
  <thead>
    <tr>
      <th>Motorista</th>
      <th>Caminhão</th>
      <th>Entrada no pátio</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @yard_visits.each do |visit| %>
      <tr>
        <td><%= visit.driver.name %></td>
        <td><%= visit.truck.plate %></td>
        <td><%= visit.entered_yard_at.strftime("%d/%m/%Y %H:%M") %></td>
        <td>
          <%= form_with url: issue_order_expedition_visit_path(visit), method: :patch, scope: :visit do |f| %>
            <%= f.text_field :order_number, placeholder: "Número da ordem", required: true %>
            <%= f.submit "Emitir ordem" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<h2>Fila</h2>

<table>
  <thead>
    <tr>
      <th>Posição</th>
      <th>Motorista</th>
      <th>Caminhão</th>
      <th>Ordem</th>
      <th>Status</th>
    </tr>
  </thead>
  <tbody>
    <% @queue_visits.each do |visit| %>
      <tr>
        <td><%= visit.loading? ? "-" : visit.queue_position %></td>
        <td><%= visit.driver.name %></td>
        <td><%= visit.truck.plate %></td>
        <td><%= visit.order_number %></td>
        <td><%= visit.loading? ? "Carregando" : "Na fila" %></td>
      </tr>
    <% end %>
  </tbody>
</table>
